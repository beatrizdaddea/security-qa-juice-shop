{
  "name": "security-qa-juice-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Security-focused QA portfolio for a local OWASP Juice Shop instance.",
  "scripts": {
    "test": "npm run cy:run",
    "precy:run": "node ./scripts/clean-allure.cjs",
    "cy:open": "node ./node_modules/cypress/bin/cypress open",
    "cy:run": "node ./node_modules/cypress/bin/cypress run",
    "test:api": "node ./node_modules/cypress/bin/cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:ui": "node ./node_modules/cypress/bin/cypress run --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "allure:generate": "node ./scripts/allure-cli.cjs generate allure-results --clean -o allure-report",
    "allure:open": "node ./scripts/allure-cli.cjs open allure-report",
    "prepw:test": "node ./scripts/clean-playwright.cjs",
    "pw:test": "node ./node_modules/@playwright/test/cli.js test",
    "prepw:security": "node ./scripts/clean-security.cjs",
    "pw:security": "node ./node_modules/@playwright/test/cli.js test --config playwright.security.config.ts",
    "postpw:security": "node ./scripts/verify-security-results.cjs",
    "pw:security:allure": "docker compose --profile security run --rm allure-security",
    "sec:zap:up": "node ./scripts/zap.cjs up",
    "sec:zap:baseline": "node ./scripts/zap.cjs baseline",
    "sec:zap:full": "node ./scripts/zap.cjs full",
    "sec:zap:report": "node ./scripts/zap.cjs report",
    "sec:zap:verify-proxy": "node ./scripts/zap.cjs verify-proxy",
    "lint": "node ./scripts/lint.cjs",
    "ci:run": "node ./scripts/ci-run.cjs",
    "quality:gate": "node --experimental-strip-types ./scripts/quality-gate.ts",
    "quality:gate:verify": "node --experimental-strip-types ./scripts/verify-quality-gate.ts",
    "ci:allure": "node ./scripts/ci-allure.cjs",
    "pw:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "pw:headed": "node ./node_modules/@playwright/test/cli.js test --headed",
    "pw:debug": "node ./node_modules/@playwright/test/cli.js test --debug",
    "cy:headed": "node ./node_modules/cypress/bin/cypress run --headed",
    "pw:report": "node ./node_modules/@playwright/test/cli.js show-report playwright-report",
    "pw:install": "node ./node_modules/@playwright/test/cli.js install chromium",
    "pw:typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.playwright.json --noEmit",
    "pw:allure:generate": "node ./scripts/allure-cli.cjs generate allure-results-playwright --clean -o allure-report-playwright",
    "pw:allure:open": "node ./scripts/allure-cli.cjs open allure-report-playwright"
  },
  "keywords": [
    "qa",
    "security-testing",
    "owasp-juice-shop",
    "cypress",
    "allure"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure-commandline": "^2.46.1",
    "allure-cypress": "^3.13.0",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cypress": "^16.1.1",
    "typescript": "^7.0.2"
  }
}
