# Copy to .env for local overrides. Never commit real secrets.
# Playwright target (must be localhost; the config rejects any other host)
BASE_URL=http://localhost:3000
# The security suite requires this exact URL, including scheme and port.
# A suíte de segurança exige esta URL exata, incluindo protocolo e porta.

# Generated locally by npm run sec:zap:up; never commit the real API key.
# Gerada localmente por npm run sec:zap:up; nunca versione a chave real da API.
ZAP_API_KEY=
# Optional: route Playwright browser/API/setup traffic through the local ZAP.
# Opcional: encaminhe tráfego do navegador/API/setup Playwright pelo ZAP local.
# ZAP_PROXY=http://localhost:8080

# Evidence: on | off | retain-on-failure  (defaults: local "on", CI "retain-on-failure")
# PW_TRACE=on
# PW_VIDEO=on
# PW_SCREENSHOT=on

# Enable the optional Firefox project (requires: playwright install firefox)
# PW_FIREFOX=1
