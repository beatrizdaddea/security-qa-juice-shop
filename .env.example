# Copy to .env for local overrides. Never commit real secrets.
# Playwright target (must be localhost; the config rejects any other host)
BASE_URL=http://localhost:3000

# Evidence: on | off | retain-on-failure  (defaults: local "on", CI "retain-on-failure")
# PW_TRACE=on
# PW_VIDEO=on
# PW_SCREENSHOT=on

# Enable the optional Firefox project (requires: playwright install firefox)
# PW_FIREFOX=1
